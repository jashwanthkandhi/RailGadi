# ============================================================
# RailGadi Environment Variables Template (.env.example)
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# MAP TILES — MapTiler (https://cloud.maptiler.com/account/keys/)
# Used for railway-styled vector map rendering
# ------------------------------------------------------------
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# ------------------------------------------------------------
# LIVE TRAIN DATA — RailRadar
# Real-time Indian Railway train status, GPS & live schedule
# ------------------------------------------------------------
VITE_RAILRADAR_API_KEY=your_railradar_api_key_here
VITE_RAILRADAR_BASE_URL=/api/v1

# ------------------------------------------------------------
# WEATHER — OpenWeatherMap (https://openweathermap.org/api)
# Weather conditions along route stations
# ------------------------------------------------------------
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
VITE_OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# ------------------------------------------------------------
# ELEVATION — Open-Elevation & OpenTopography
# Route elevation profile and track gradient charts
# ------------------------------------------------------------
VITE_OPENELEVATION_BASE_URL=https://api.open-elevation.com/api/v1/lookup
VITE_OPENTOPO_API_KEY=your_opentopo_api_key_here

# ------------------------------------------------------------
# BACKEND & APP CONFIGURATION
# ------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_APP_NAME=RailGaadi
VITE_APP_VERSION=2.0.0
VITE_JOURNEY_REFRESH_INTERVAL_MS=60000
VITE_SEARCH_DEBOUNCE_MS=350
